# Copie para .env.local (local) ou cadastre na Vercel. Nunca faça commit dos valores.

# Supabase (servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify: o token cadastrado no webhook (Apps > Webhooks). Use um valor longo e aleatório.
KIWIFY_WEBHOOK_TOKEN=
# Opcional, só durante a troca de token: o token anterior
KIWIFY_WEBHOOK_TOKEN_PREVIOUS=
